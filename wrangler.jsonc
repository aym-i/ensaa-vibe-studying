{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ai-ensa-ds",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"ai": { "binding": "AI" },
	"r2_buckets": [
		{ "binding": "BUCKET", "bucket_name": "enssa-resumes" }
	],
	"workers_dev": true,
	"preview_urls": true
}
